@model AdminOrdersViewModel
@{
    ViewData["Title"] = "Quản lý đơn hàng — NHÀ GIẢ KIM";
    ViewData["Nav"] = "admin";
    var ok = TempData["Ok"] as string;
    var error = TempData["Error"] as string;
    var total = Model.Counts.Values.Sum();
    string TabCss(bool active) => active
        ? "bg-[#111111] text-white border-[#111111]"
        : "bg-white text-[#666666] border-[#E5E5E5] hover:border-[#111111] hover:text-[#111111]";
}

<section class="py-16 md:py-20 bg-[#F5F5F5] border-b border-[#E5E5E5]">
    <div class="max-w-[1240px] mx-auto px-6">
        @* ================= THỐNG KÊ ================= *@
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
            <div class="bg-white border border-[#E5E5E5] rounded-[8px] p-6">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#666666]">Số cuốn đã đặt</div>
                <div class="mt-3 text-3xl font-bold text-[#111111] tracking-tight">@Model.TotalQuantity.ToString("N0", new CultureInfo("vi-VN"))</div>
                <div class="mt-1 text-xs text-[#999999]">Không tính đơn đã hủy</div>
            </div>
            <div class="bg-white border border-[#E5E5E5] rounded-[8px] p-6">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#666666]">Số đánh giá</div>
                <div class="mt-3 text-3xl font-bold text-[#111111] tracking-tight">@Model.FeedbackCount.ToString("N0", new CultureInfo("vi-VN"))</div>
                <div class="mt-1 text-xs text-[#999999]">Tất cả đánh giá của bạn đọc</div>
            </div>
            <div class="bg-white border border-[#E5E5E5] rounded-[8px] p-6">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#666666]">Số lượng trong kho</div>
                <div class="mt-3 text-3xl font-bold tracking-tight @(Model.Stock > 0 ? "text-[#111111]" : "text-red-600")">@Model.Stock.ToString("N0", new CultureInfo("vi-VN"))</div>
                <div class="mt-1 text-xs text-[#999999]">Tình trạng: @(Model.Stock > 0 ? "Còn hàng" : "Hết hàng")</div>
                <form method="post" asp-action="UpdateStock" class="mt-4 flex gap-2">
                    <input type="hidden" name="statusId" value="@Model.FilterStatusId" />
                    <input type="number" name="stock" min="0" max="100000" step="1" value="@Model.Stock" required
                           aria-label="Số lượng trong kho" class="custom-input w-full" />
                    <button type="submit" class="bg-[#111111] text-white px-4 rounded-[8px] text-xs font-semibold uppercase tracking-wider hover:bg-[#2A2A2A] cursor-pointer whitespace-nowrap">Lưu</button>
                </form>
            </div>
            <div class="bg-white border border-[#E5E5E5] rounded-[8px] p-6">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#666666]">Doanh thu</div>
                <div class="mt-3 text-3xl font-bold text-[#111111] tracking-tight">@Vnd.Format(Model.TotalRevenue)</div>
                <div class="mt-1 text-xs text-[#999999]">Không tính đơn đã hủy</div>
            </div>
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
            <div>
                <span class="text-[12px] font-semibold uppercase tracking-[0.25em] text-[#666666] block mb-3">Khu vực quản trị</span>
                <h1 class="text-3xl md:text-4xl font-bold text-[#111111] tracking-tight">Quản lý đơn hàng</h1>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ok))
        {
            <div class="mb-6 p-4 rounded-[8px] border border-[#111111] bg-white text-sm font-medium text-[#111111]">@ok</div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="mb-6 p-4 rounded-[8px] border border-red-300 bg-red-50 text-sm font-medium text-red-700">@error</div>
        }

        <div class="flex flex-wrap gap-2 mb-6 text-sm font-medium">
            <a href="~/quan-tri/don-hang" class="px-4 py-2 rounded-[8px] border @TabCss(Model.FilterStatusId == null)">Tất cả (@total)</a>
            @foreach (var s in Model.Statuses)
            {
                var n = Model.Counts.TryGetValue(s.StatusId, out var c) ? c : 0;
                <a href="~/quan-tri/don-hang?statusId=@s.StatusId" class="px-4 py-2 rounded-[8px] border @TabCss(Model.FilterStatusId == s.StatusId)">@s.StatusName (@n)</a>
            }
        </div>

        <div class="bg-white border border-[#E5E5E5] rounded-[8px] overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs uppercase tracking-wider text-[#666666] border-b border-[#E5E5E5] bg-[#FAFAFA]">
                    <tr>
                        <th class="px-5 py-4 font-semibold">Mã đơn</th>
                        <th class="px-5 py-4 font-semibold">Khách hàng</th>
                        <th class="px-5 py-4 font-semibold">Địa chỉ</th>
                        <th class="px-5 py-4 font-semibold text-center">SL</th>
                        <th class="px-5 py-4 font-semibold">Tổng tiền</th>
                        <th class="px-5 py-4 font-semibold">Thanh toán</th>
                        <th class="px-5 py-4 font-semibold">Trạng thái</th>
                        <th class="px-5 py-4 font-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E5E5E5]">
                    @if (Model.Orders.Count == 0)
                    {
                        <tr><td colspan="8" class="px-5 py-10 text-center text-[#666666]">Chưa có đơn hàng nào.</td></tr>
                    }
                    @foreach (var o in Model.Orders)
                    {
                        <tr class="align-top">
                            <td class="px-5 py-4">
                                <div class="font-bold text-[#111111] whitespace-nowrap">#@o.OrderCode</div>
                                <div class="text-xs text-[#666666] mt-1 whitespace-nowrap">@o.OrderTime.ToString("HH:mm dd/MM/yyyy")</div>
                            </td>
                            <td class="px-5 py-4">
                                <div class="font-semibold text-[#111111]">@o.CustomerName</div>
                                <div class="text-xs text-[#666666] mt-1">@o.Phone</div>
                            </td>
                            <td class="px-5 py-4 min-w-[220px] max-w-[320px]">
                                <div class="text-[#111111]">@o.Address</div>
                                @if (!string.IsNullOrWhiteSpace(o.Note))
                                {
                                    <div class="text-xs text-[#666666] mt-1">Ghi chú: @o.Note</div>
                                }
                            </td>
                            <td class="px-5 py-4 text-center font-semibold">@o.Quantity</td>
                            <td class="px-5 py-4 font-bold text-[#111111] whitespace-nowrap">@Vnd.Format(o.TotalAmount)</td>
                            <td class="px-5 py-4 whitespace-nowrap">@(o.PaymentMethod == "COD" ? "COD" : "Chuyển khoản")</td>
                            <td class="px-5 py-4">
                                <span class="@OrderStatusNames.BadgeCss(o.Status.StatusName) text-xs font-semibold px-2.5 py-1 rounded-[4px] tracking-wide whitespace-nowrap">@o.Status.StatusName</span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var next in OrderStatusNames.NextOf(o.Status.StatusName))
                                    {
                                        var target = Model.Statuses.FirstOrDefault(s => s.StatusName == next);
                                        if (target == null) { continue; }
                                        var isCancel = next == OrderStatusNames.Cancelled;
                                        <form method="post" asp-action="UpdateStatus" asp-route-id="@o.OrderId">
                                            <input type="hidden" name="newStatusId" value="@target.StatusId" />
                                            <input type="hidden" name="statusId" value="@Model.FilterStatusId" />
                                            <button type="submit"
                                                    onclick="@(isCancel ? "return confirm('Hủy đơn này?')" : "")"
                                                    class="@(isCancel ? "bg-white text-[#666666] border border-[#E5E5E5] hover:border-[#111111] hover:text-[#111111]" : "bg-[#111111] text-white border border-[#111111] hover:bg-[#2A2A2A]") text-xs font-semibold px-3 h-[34px] rounded-[6px] whitespace-nowrap transition-colors cursor-pointer">
                                                @OrderStatusNames.ActionLabel(next)
                                            </button>
                                        </form>
                                    }
                                    @if (OrderStatusNames.NextOf(o.Status.StatusName).Length == 0)
                                    {
                                        <span class="text-xs text-[#999999]">—</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
